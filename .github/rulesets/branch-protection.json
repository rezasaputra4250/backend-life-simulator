{
  "name": "Perlindungan alur branch backend",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/local",
        "refs/heads/develop",
        "refs/heads/staging",
        "refs/heads/main",
        "refs/heads/master"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": true,
        "required_approving_review_count": 1,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Validasi aturan Pull Request",
            "integration_id": -1
          },
          {
            "context": "Validasi file sensitif",
            "integration_id": -1
          },
          {
            "context": "Pemeriksaan Node.js backend",
            "integration_id": -1
          },
          {
            "context": "Audit dependency",
            "integration_id": -1
          },
          {
            "context": "Scan keamanan Semgrep",
            "integration_id": -1
          },
          {
            "context": "Scan secret dengan Gitleaks",
            "integration_id": -1
          },
          {
            "context": "Analisis keamanan CodeQL",
            "integration_id": -1
          }
        ],
        "strict_required_status_checks_policy": true
      }
    }
  ]
}
