# Salin file ini menjadi .env. Jangan commit file .env yang berisi nilai asli.
# Gunakan nilai berbeda untuk development, staging, dan production.

# Identitas aplikasi
APP_NAME=Backend API
APP_ENV=local
NODE_ENV=development
HOST=0.0.0.0
PORT=5000

# Database MySQL
# Development lokal biasanya memakai 127.0.0.1.
# Pada cPanel/server, gunakan host database yang diberikan provider.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=backend

# JWT
# Ganti dengan secret acak yang panjang pada staging dan production.
JWT_SECRET=change_this_secret_before_production
JWT_EXPIRES_IN=1d

# Reset password
PASSWORD_RESET_EXPIRES_MINUTES=15
# Ganti dengan URL aplikasi yang benar pada staging/production.
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password

# Seeder database
# Variabel ini hanya diperlukan saat menjalankan npm run db:seed.
# Jangan menjalankan seeder contoh di production tanpa peninjauan.
SEED_USER_COUNT=100
SEED_USER_EMAIL=demo@rpg-life.local
SEED_USER_PASSWORD=password
SEED_USER_NAME=Petualang Demo
# Isi dengan ID user yang akan menjadi pemilik guild seed.
# Jika 0 atau kosong, seeder akan memilih user aktif yang tersedia.
SEED_GUILD_OWNER_ID=0
